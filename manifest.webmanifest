{
  "id": "/",
  "name": "Splice & Co.",
  "short_name": "Splice & Co.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "handle_links": "preferred",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New task", "url": "/#/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Overview", "url": "/#/overview", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "/#/calendar", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Quick search", "url": "/#/search", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
